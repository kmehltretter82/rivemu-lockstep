+bool ModelImpl::set_csr(uint16_t reg, uint64_t val) {
+  sbits sail_val;
+  sail_val.len = zxlen;
+  sail_val.bits = val;
+
+  // write_CSR returns a generated result whose successful arm owns an lbits.
+  // Initialize it to the unit error arm and release the successful value after
+  // the CSR's normal WARL/WLRL legalization has run.
+  hart::zresultzIbzCuzK result{};
+  result.kind = hart::Kind_zErrzIbzCuzK;
+  zwrite_CSR(&result, reg, sail_val);
+  if (result.kind == hart::Kind_zOkzIbzCuzK) {
+    KILL(lbits)(&result.variants.zOkzIbzCuzK);
+    return true;
+  }
+  return false;
+}
