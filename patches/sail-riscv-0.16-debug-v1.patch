+std::optional<uint64_t> little_endian_hex_to_opt_uint64t(const std::string &str) {
+  if (str.empty() || (str.size() % 2) != 0 || str.size() > 2 * sizeof(uint64_t)) {
+    return std::nullopt;
+  }
+
+  uint64_t result = 0;
+  for (size_t byte_idx = 0; byte_idx < str.size() / 2; ++byte_idx) {
+    uint8_t byte = 0;
+    const char *begin = str.data() + byte_idx * 2;
+    const char *end = begin + 2;
+    auto [ptr, ec] = std::from_chars(begin, end, byte, 16);
+    if (ec != std::errc() || ptr != end) {
+      return std::nullopt;
+    }
+    result |= static_cast<uint64_t>(byte) << (byte_idx * 8);
+  }
+  return result;
+}
