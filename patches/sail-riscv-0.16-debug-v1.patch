+class write_hex_data : public request::request_parser {
+public:
+  write_hex_data() = default;
+
+  // M addr,length:XX...
+  // `length` is in bytes and `XX...` contains two hexadecimal digits per byte.
+  std::optional<response_handler_ptr> parse(const std::string &cmd, gdb_run_info &info) const override {
+    std::string tag{"M"};
+    auto idx = cmd.find(tag);
+    if (idx != 0) {
+      return std::nullopt;
+    }
+    idx += tag.length();
+    auto last_idx = idx;
+    idx = cmd.find(',', last_idx);
+    if (idx == std::string::npos) {
+      return std::nullopt;
+    }
+
+    auto opt_addr = string_to_opt_uint64t(cmd.substr(last_idx, idx - last_idx));
+    if (!opt_addr.has_value()) {
+      return std::nullopt;
+    }
+
+    ++idx;
+    last_idx = idx;
+    idx = cmd.find(':', last_idx);
+    if (idx == std::string::npos) {
+      return std::nullopt;
+    }
+    auto opt_length = string_to_opt_uint64t(cmd.substr(last_idx, idx - last_idx));
+    if (!opt_length.has_value()) {
+      return std::nullopt;
+    }
+
+    ++idx;
+    const std::string hex = cmd.substr(idx);
+    if ((hex.size() % 2) != 0 || opt_length.value() != hex.size() / 2) {
+      if (info.enable_trace) {
+        fprintf(
+          info.trace_log,
+          "write_hex_data: packet specifies %" PRIu64 " bytes but contains %zu hexadecimal characters\n",
+          opt_length.value(),
+          hex.size()
+        );
+      }
+      return std::nullopt;
+    }
+
+    std::string data;
+    data.reserve(hex.size() / 2);
+    for (size_t i = 0; i < hex.size(); i += 2) {
+      auto opt_byte = string_to_opt_uint64t(hex.substr(i, 2));
+      if (!opt_byte.has_value()) {
+        return std::nullopt;
+      }
+      data.push_back(static_cast<char>(opt_byte.value()));
+    }
+    return response_handler_ptr(
+      new response::write_binary_data(opt_addr.value(), opt_length.value(), std::move(data))
+    );
   }
 };
 
